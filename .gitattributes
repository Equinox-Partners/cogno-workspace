# .gitattributes for Equinox Partners Cogno Workspace
# See https://git-scm.com/docs/gitattributes

# Auto normalize line endings for all text files
* text=auto

# Documents
*.md text
*.txt text
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.toml text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf

# Programming languages
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.py text eol=lf
*.go text eol=lf
*.java text eol=lf
*.rs text eol=lf

# Configuration files
.env* text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
Dockerfile* text eol=lf
*.conf text eol=lf

# Documentation
*.pdf binary
*.doc binary
*.docx binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text

# Archives
*.zip binary
*.tar binary
*.gz binary
*.tar.gz binary
*.7z binary
*.rar binary

# Build artifacts - should not be committed
build/ linguist-generated=true
dist/ linguist-generated=true
*.egg-info/ linguist-generated=true
